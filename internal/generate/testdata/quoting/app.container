[Unit]
Description=app (from compose service app)

[Container]
ContainerName=app
Image=docker.io/library/alpine:3.20
Entrypoint=["/bin/sh","-c"]
Exec="echo \"hi there\"; sleep inf" "hello world" &&
Environment=GREETING="hello world"
Environment=PLAIN=plain
Environment=QUOTED="say \"hi\""
Network=quoting-net.network
Sysctl=net.ipv4.ping_group_range="0 1000"
Label=description="a label with spaces"
HealthCmd=["CMD","test","-f","/tmp/my file"]
HealthInterval=30s

[Service]
Restart=no

[Install]
WantedBy=default.target
