# Generated by quaddoc from compose service "cache".

[Unit]
Description=cache (from compose service cache)

[Container]
ContainerName=cache
Image=docker.io/library/redis:7
Exec=redis-server --save 60 1
User=999
Group=999
# 
# Named volume "cachedata" refers to the cachedata.volume unit, which Podman
# materialises as a volume called `systemd-cachedata`. The .volume suffix is
# what creates the dependency between the two units.
Volume=cachedata.volume:/data
Network=webstack-net.network

[Service]
Restart=always

[Install]
WantedBy=default.target
