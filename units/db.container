# Generated by quaddoc from compose service "db".

[Unit]
Description=db (from compose service db)

[Container]
ContainerName=db
Image=docker.io/library/postgres:16
Environment=POSTGRES_DB=app
Environment=POSTGRES_PASSWORD=hunter2
# 
# Named volume "pgdata" refers to the pgdata.volume unit, which Podman
# materialises as a volume called `systemd-pgdata`. The .volume suffix is
# what creates the dependency between the two units.
Volume=pgdata.volume:/var/lib/postgresql/data
# 
# Bind mount of
# /home/oliverh/repos/github/MatrixMagician/QuadDoc/testdata/fixtures/webstack/certs.
# On an SELinux system this needs a relabelling option, `:Z` for a source
# used by this container alone or `:z` for one shared with others. quaddoc
# does not guess: run `quaddoc lint` to see which applies, and `quaddoc fix`
# to apply it.
Volume=/home/oliverh/repos/github/MatrixMagician/QuadDoc/testdata/fixtures/webstack/certs:/etc/postgresql/certs:ro
Network=webstack-net.network
HealthCmd=pg_isready -U postgres
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=default.target
