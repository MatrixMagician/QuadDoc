# Generated by quaddoc from compose service "web".

[Unit]
Description=web (from compose service web)
After=cache.service
Requires=cache.service
# 
# compose had `depends_on: db: condition: service_healthy`. systemd orders
# units but does not gate on health, so After= alone starts this container
# as soon as db has *started*, not once it is healthy. To close the gap, set
# Notify=healthy on db.container together with a healthcheck: its service
# then reports started only once Podman marks it healthy.
After=db.service
Requires=db.service

[Container]
ContainerName=web
Image=docker.io/library/nginx:1.27
Environment=API_TOKEN=sk_live_not_a_real_token
Environment=NGINX_HOST=example.invalid
# 
# Bind mount of
# /home/oliverh/repos/github/MatrixMagician/QuadDoc/testdata/fixtures/webstack/site.
# On an SELinux system this needs a relabelling option, `:Z` for a source
# used by this container alone or `:z` for one shared with others. quaddoc
# does not guess: run `quaddoc lint` to see which applies, and `quaddoc fix`
# to apply it.
Volume=/home/oliverh/repos/github/MatrixMagician/QuadDoc/testdata/fixtures/webstack/site:/usr/share/nginx/html:ro
# 
# Bind mount of
# /home/oliverh/repos/github/MatrixMagician/QuadDoc/testdata/fixtures/webstack/certs.
# On an SELinux system this needs a relabelling option, `:Z` for a source
# used by this container alone or `:z` for one shared with others. quaddoc
# does not guess: run `quaddoc lint` to see which applies, and `quaddoc fix`
# to apply it.
Volume=/home/oliverh/repos/github/MatrixMagician/QuadDoc/testdata/fixtures/webstack/certs:/etc/nginx/certs
PublishPort=8080:80
PublishPort=8443:443
Network=webstack-net.network

[Service]
# 
# compose used `restart: unless-stopped`, which systemd cannot express
# exactly. Restart=always is the closest: systemd honours an explicit
# `systemctl stop` for as long as the machine stays up, and starts the unit
# again at boot because of the [Install] section.
Restart=always

[Install]
WantedBy=default.target
