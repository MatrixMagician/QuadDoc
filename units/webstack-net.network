# Generated by quaddoc from a compose project.
# 
# Compose gives every service a DNS name that its siblings can resolve.
# Podman's default network has DNS disabled, so a shared user-defined
# network like this one is required to preserve that behaviour, not merely a
# tidier way to arrange things.
# 
# Podman names the network created by this unit `systemd-webstack-net`.

[Network]
NetworkName=webstack

[Install]
WantedBy=default.target
