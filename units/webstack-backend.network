# Generated by quaddoc from compose network "backend".
#
# Compose gives every service a DNS name that its siblings can resolve.
# Podman's default network has DNS disabled, so a user-defined network like
# this one is required to preserve that behaviour, not merely a tidier way
# to arrange things.
#
# NetworkName= makes Podman name the network `webstack_backend`, the name
# compose gives it, rather than Quadlet's default of
# `systemd-webstack-backend`.

[Network]
NetworkName=webstack_backend

[Install]
WantedBy=default.target
